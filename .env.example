# Copie ces variables dans Vercel > Project > Settings > Environment Variables.
# Sur Vercel, l'intégration Neon renseigne DATABASE_URL automatiquement.

# Connexion Postgres Neon (pooled ou directe, les deux fonctionnent)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Connexion Google (optionnelle tant que tu n'as pas créé le client OAuth)
# URI de redirection autorisée : https://<ton-domaine>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : force l'URI de redirection (utile en préversion)
GOOGLE_REDIRECT_URI=

# Uniquement si l'API est servie depuis un autre domaine que le site
# VITE_API_BASE=https://anglais-pro.vercel.app
